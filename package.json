{
  "name": "replate",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js --host 0.0.0.0",
    "server": "json-server --watch data/db.json --port 5000",
    "start": "concurrently \"npm run server\" \"npm run dev\"",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview --host 0.0.0.0",
    "postinstall": "node -e \"const fs=require('fs'); const p='node_modules/.bin/vite'; if (fs.existsSync(p)) fs.chmodSync(p, 0o755);\""
  },
  "dependencies": {
    "axios": "^1.7.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.4.0",
    "react-router-dom": "^6.28.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "json-server": "^0.17.4",
    "vite": "^5.4.11"
  }
}
